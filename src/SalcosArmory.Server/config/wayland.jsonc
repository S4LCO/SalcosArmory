{
  // Show Wayland's offers when players search for these items on the flea market.
  "showOffersOnFlea": true,

  // Automatic price order:
  // 1. An item-specific "price" below is a fixed final price and skips automatic pricing.
  // 2. "flea" uses fleaPriceRoubles and falls back to handbookPriceRoubles.
  // 3. "handbook" always uses handbookPriceRoubles instead.
  // 4. An automatically selected price is multiplied by priceMultiplier and cannot fall below minimumPrice.
  "priceSource": "flea",

  // Multiplies every automatically generated price. 1.0 means 100%, 1.2 means 120%.
  "priceMultiplier": 1.0,
  "minimumPrice": 1,

  // Wayland refreshes after a random duration inside this range.
  "refreshTimeMinMinutes": 60,
  "refreshTimeMaxMinutes": 120,

  // Default loyalty level and personal purchase limit per refresh for every content folder.
  // Armor inserts inside a Level_3/4/5/6 folder automatically use LL1/2/3/4.
  "categories": {
    "CustomAmmo":       { "loyaltyLevel": 2, "stock": 180 },
    "CustomContainers": { "loyaltyLevel": 2, "stock": 1 },
    "CustomGear":       { "loyaltyLevel": 2, "stock": 2 },
    "CustomMagazines":  { "loyaltyLevel": 2, "stock": 8 },
    "CustomMeds":       { "loyaltyLevel": 2, "stock": 3 },
    "CustomWeapons":    { "loyaltyLevel": 2, "stock": 2 }
  },

  // Item-specific values override the category defaults above.
  // Set "enabled" to false if an item should not be sold by Wayland.
  // Add "price" only when an item should use a fixed price instead of the automatic one.
  "itemOverrides": {
    // Ammunition
    "6a46b5ec55354e6b4b5f2756": { "loyaltyLevel": 2, "stock": 180 }, // .45 ACP Warden
    "6a46b4e970caf2c92cda1007": { "loyaltyLevel": 4, "stock": 120 }, // 5.45x39 7N39M
    "6a46b4fef14c448553778f95": { "loyaltyLevel": 4, "stock": 120 }, // 5.56x45 M995A1
    "6a46a967bae4cc4c6974ff63": { "loyaltyLevel": 4, "stock": 80 },  // 6.8x51 Blutadler
    "6a46a98a99b1351b560843ef": { "loyaltyLevel": 3, "stock": 120 }, // .300 BLK Spartans
    "6a46b5d55aa43208a7bb9f5d": { "loyaltyLevel": 3, "stock": 120 }, // 7.62x39 7N23M

    // Containers and special equipment
    "6a46baee0d186b7e2875018c": { "loyaltyLevel": 2, "stock": 1 }, // Ammo Pouch

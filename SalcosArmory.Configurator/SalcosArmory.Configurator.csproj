<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>SALCOs ARMORY Configurator</AssemblyName>
    <RootNamespace>SalcosArmory.Configurator</RootNamespace>
    <Version>0.6.2</Version>
    <AssemblyVersion>0.6.2.0</AssemblyVersion>
    <FileVersion>0.6.2.0</FileVersion>
    <Description>Configuration utility for SALCO's ARMORY.</Description>
    <Company>Salco</Company>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugSymbols>false</DebugSymbols>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\SalcosArmory.Server\config\settings.json" Link="Defaults\settings.json" />
    <EmbeddedResource Include="..\SalcosArmory.Server\config\countermeasure_protocol.jsonc" Link="Defaults\countermeasure_protocol.jsonc" />
    <EmbeddedResource Include="..\SalcosArmory.Server\config\wayland.jsonc" Link="Defaults\wayland.jsonc" />
    <EmbeddedResource Include="..\SalcosArmory.Server\config\soft_armor_balance.jsonc" Link="Defaults\soft_armor_balance.jsonc" />
    <EmbeddedResource Include="..\SalcosArmory.Server\config\runtime_injection.json" Link="Defaults\runtime_injection.json" />
  </ItemGroup>
</Project>

<Window x:Class="SalcosArmory.Configurator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SALCO's ARMORY Configurator"
        Width="1320"
        Height="840"
        MinWidth="1040"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Language="en-US"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        ToolTipService.InitialShowDelay="250"
        ToolTipService.ShowDuration="30000">
    <DockPanel>
        <Border DockPanel.Dock="Top"
                Background="#182029"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="18,13">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="SALCO'S ARMORY"
                               FontSize="21"
                               FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}" />
                    <TextBlock Text="CONFIGURATOR  •  0.6.2"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="11" />
                </StackPanel>

                <Grid Grid.Column="1" Margin="28,0,12,0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="Config folder"
                               Foreground="{StaticResource MutedTextBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                    <TextBox Grid.Column="1"
                             Text="{Binding ConfigDirectory}"
                             IsReadOnly="True"
                             VerticalContentAlignment="Center" />
                </Grid>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Browse…" Click="Browse_Click"
                            ToolTip="Choose your SPT folder or the SalcosArmory config folder manually." />
                    <Button Content="Reload" Click="Reload_Click"
                            ToolTip="Discard unsaved edits and read the current configuration files again." />
                    <Button Content="Import" Click="Import_Click"
                            ToolTip="Import a configuration package that was previously exported by SAC." />
                    <Button Content="Export" Click="Export_Click"
                            ToolTip="Create a portable backup package containing your current SALCO's ARMORY configuration." />
                </StackPanel>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom"
                Background="#182029"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="14,9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusText"
                               Text="Select your SPT installation to begin."
                               Foreground="{StaticResource MutedTextBrush}" />
                    <TextBlock Text="Server-side changes are applied after restarting the SPT server."
                               FontSize="11"
                               Foreground="#768390" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Restore tab defaults" Click="ResetTab_Click"
                            ToolTip="Reset only the currently selected tab to SALCO's ARMORY default values. You can still cancel by closing SAC without saving." />
                    <Button Content="Save changes"
                            Style="{StaticResource PrimaryButton}"
                            MinWidth="145"
                            ToolTip="Validate all settings, create a backup and write the changes to the mod config files. Restart the SPT server afterwards."
                            Click="Save_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid x:Name="EditorRoot" IsEnabled="False">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0"
                    Background="#182029"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="5"
                    Margin="12,12,12,0"
                    Padding="10,7">
                <TextBlock Foreground="{StaticResource MutedTextBrush}"
                           TextWrapping="Wrap"
                           Text="Need help? Move the mouse over any setting. SAC explains what it changes and gives examples. Save changes, then restart the SPT server." />
            </Border>
            <TabControl x:Name="ConfigTabs" Grid.Row="1" Margin="12">
                <TabItem Header="General">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid Margin="12" DataContext="{Binding General}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <GroupBox Grid.Column="0" Header="Content loading">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource HintText}"
                                               Text="Control which content folders CommonLib registers during server startup." />
                                    <CheckBox Content="Custom items" IsChecked="{Binding LoadItems}"
                                              ToolTip="Loads the weapons, attachments, medical items and other custom items included with SALCO's ARMORY. Normal users should leave this enabled." />
                                    <CheckBox Content="Weapon presets" IsChecked="{Binding LoadWeaponPresets}"
                                              ToolTip="Loads the ready-made weapon builds supplied by the mod. Disable this only if you do not want those presets to appear." />
                                    <CheckBox Content="Hideout recipes" IsChecked="{Binding LoadHideoutRecipes}"
                                              ToolTip="Loads SALCO's ARMORY crafting recipes into the Hideout. This does not disable the Hideout itself." />
                                    <CheckBox Content="Locales" IsChecked="{Binding LoadLocales}"
                                              ToolTip="Loads item names and descriptions. Leave this enabled so custom items have readable names instead of template IDs." />
                                    <CheckBox Content="Stimulant buffs" IsChecked="{Binding LoadBuffs}"
                                              ToolTip="Loads the gameplay effects and side effects used by SALCO's ARMORY stimulants. Leave this enabled when using the mod's stims." />
                                    <CheckBox Content="Compatibility rules" IsChecked="{Binding LoadCompat}"
                                              ToolTip="Loads attachment and item compatibility rules. Normal users should leave this enabled." />
                                </StackPanel>
                            </GroupBox>

                            <StackPanel Grid.Column="1">
                                <GroupBox Header="Gameplay systems">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource HintText}"
                                                   Text="These switches enable or disable complete SALCO's ARMORY systems." />
                                        <CheckBox Content="Runtime item injection" IsChecked="{Binding LoadRuntimeInjection}"
                                                  ToolTip="Adds configured items or inserts to existing equipment while the server is loading. Required for SALCO's ARMORY features that modify existing item slots." />
                                        <CheckBox Content="Medical item merging" IsChecked="{Binding LoadMedicalMerge}"
                                                  ToolTip="Lets you combine two partially used medical items of the same type. Example: an UFAK with 365 HP can absorb the remaining HP from another UFAK." />
                                        <CheckBox Content="Countermeasure Protocol" IsChecked="{Binding LoadCountermeasureProtocol}"
                                                  ToolTip="Enables CP. It studies your recent PMC raids and equips a limited number of enemy PMCs with countermeasures to repeated tactics." />
                                        <CheckBox Content="Wayland trader" IsChecked="{Binding LoadWaylandTrader}"
                                                  ToolTip="Enables Wayland and his SALCO's ARMORY inventory. Disable this if you do not want the custom trader." />
                                        <CheckBox Content="Three additional Special Slots" IsChecked="{Binding LoadExtendedSpecialSlots}"
                                                  ToolTip="Expands the player inventory from three to six Special Slots. Disable this to keep the vanilla three-slot layout." />
                                    </StackPanel>
                                </GroupBox>

                                <GroupBox Header="Diagnostics">
                                    <StackPanel>
                                        <CheckBox Content="Detailed startup logging" IsChecked="{Binding Debug}"
                                                  ToolTip="Prints extra technical information to the server console. Enable this only while troubleshooting; it creates more log messages." />
                                        <CheckBox Content="Strict mode – stop loading when a module fails"
                                                  IsChecked="{Binding StrictMode}"
                                                  ToolTip="Developer option. When enabled, one module error can stop the entire mod from loading. Leave this disabled for normal play." />
                                        <TextBlock Style="{StaticResource HintText}"
                                                   Text="Strict mode is intended for development. Leave it disabled for normal play." />
                                    </StackPanel>
                                </GroupBox>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Countermeasures">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid Margin="12" DataContext="{Binding Countermeasures}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <GroupBox Header="Raid history and pressure">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="105" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="History size (3–20)" Style="{StaticResource HelpLabel}"
                                                   ToolTip="How many recent PMC raids CP remembers. A larger value reacts more slowly but bases decisions on more raids. Recommended: 10." />
                                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding HistorySize, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"
                                                 ToolTip="Number of recent PMC raids stored for analysis. Recommended: 10." />
                                        <TextBlock Grid.Row="1" Text="Minimum raids" Style="{StaticResource HelpLabel}"
                                                   ToolTip="CP stays inactive until this many PMC raids have been recorded. This prevents one unusual raid from immediately changing enemies." />
                                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding MinimumRaids, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"
                                                 ToolTip="CP starts evaluating your play style after this many recorded PMC raids." />
                                        <TextBlock Grid.Row="2" Text="History decay (0.1–1.0)" Style="{StaticResource HelpLabel}"
                                                   ToolTip="Controls how strongly older raids count. 1.0 gives every stored raid equal weight. Lower values make recent raids matter more." />
                                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding HistoryDecay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"
                                                 ToolTip="1.0 = all stored raids count equally. Below 1.0 = recent raids have more influence." />
                                        <TextBlock Grid.Row="3" Text="Affected PMCs – minimum %" Style="{StaticResource HelpLabel}"
                                                   ToolTip="The lowest percentage of eligible enemy PMCs that may receive countermeasures. 25 means at least 25 percent when CP responds." />
                                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding MinimumAffectedPercent, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"
                                                 ToolTip="Minimum share of eligible enemy PMCs affected by CP, in percent." />
                                        <TextBlock Grid.Row="4" Text="Affected PMCs – maximum %" Style="{StaticResource HelpLabel}"
                                                   ToolTip="The highest percentage of eligible enemy PMCs that may receive countermeasures. 35 means never more than 35 percent." />
                                        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding MaximumAffectedPercent, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"
                                                 ToolTip="Maximum share of eligible enemy PMCs affected by CP, in percent." />
                                        <TextBlock Grid.Row="5" Text="Maximum measures per bot" Style="{StaticResource HelpLabel}"
                                                   ToolTip="Limits how many different countermeasures one affected PMC can receive. Lower values keep individual enemies fairer." />
                                        <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding MaximumCountermeasuresPerBot, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"
                                                 ToolTip="Maximum number of CP equipment changes allowed on one affected enemy PMC." />
                                    </Grid>
                                </GroupBox>

                                <GroupBox Header="Individual countermeasures">
                                    <StackPanel>
                                        <CheckBox Content="Night vision" IsChecked="{Binding EnableNightVision}"
                                                  ToolTip="Allows CP to give some enemies night-vision equipment when you frequently raid at night." />
                                        <CheckBox Content="Face protection" IsChecked="{Binding EnableFaceProtection}"
                                                  ToolTip="Allows CP to improve face protection when your recent kills contain many headshots." />
                                        <CheckBox Content="Long-range optics" IsChecked="{Binding EnableLongRangeOptics}"
                                                  ToolTip="Allows CP to fit suitable long-range optics when you repeatedly engage from long distances." />
                                        <CheckBox Content="Hearing protection" IsChecked="{Binding EnableHearingProtection}"
                                                  ToolTip="Allows CP to equip suitable hearing protection when you frequently use suppressed weapons." />
                                        <CheckBox Content="Armor-piercing ammunition" IsChecked="{Binding EnableArmorPiercingAmmo}"
                                                  ToolTip="Allows CP to improve ammunition penetration when you frequently rely on heavy armor." />
                                        <CheckBox Content="Detailed CP runtime logging" IsChecked="{Binding DebugLogging}"
                                                  ToolTip="Prints detailed CP decisions to the server console for troubleshooting. Leave disabled during normal play." />
                                    </StackPanel>
                                </GroupBox>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <GroupBox Header="Player-behaviour thresholds">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="105" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="Heavy armor class (1–6)" Style="{StaticResource HelpLabel}"
                                                   ToolTip="Armor at this class or above counts as heavy armor for CP. Example: 5 means class 5 and 6 armor count as heavy." />
                                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding HeavyArmorClassThreshold, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"
                                                 ToolTip="The minimum armor class that CP treats as heavy armor." />
                                        <TextBlock Grid.Row="1" Text="Night raid ratio (0–1)" Style="{StaticResource HelpLabel}"
                                                   ToolTip="Share of recent raids that must be night raids before CP can react. Example: 0.5 means half of your analyzed raids." />
                                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding NightRaidThreshold, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"
                                                 ToolTip="0.5 = 50 percent of analyzed raids were night raids." />
                                        <TextBlock Grid.Row="2" Text="Headshot ratio (0–1)" Style="{StaticResource HelpLabel}"
                                                   ToolTip="Share of your recorded kills that must be headshots before CP may add face protection. Example: 0.6 means 60 percent." />
                                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding HeadshotRatioThreshold, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"
                                                 ToolTip="0.6 = 60 percent of recorded kills were headshots." />
                                        <TextBlock Grid.Row="3" Text="Long-range distance (m)" Style="{StaticResource HelpLabel}"
                                                   ToolTip="Average engagement distance in meters that CP considers long range. Lower values make the long-range response trigger sooner." />
                                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding LongRangeDistanceThreshold, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"
                                                 ToolTip="Distance threshold in meters for the long-range countermeasure." />
                                        <TextBlock Grid.Row="4" Text="Suppressor usage ratio (0–1)" Style="{StaticResource HelpLabel}"
                                                   ToolTip="Share of analyzed raids in which you used a suppressed weapon. Example: 0.6 means 60 percent." />
                                        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding SuppressorUsageThreshold, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"
                                                 ToolTip="0.6 = suppressed weapons were used in 60 percent of analyzed raids." />
                                        <TextBlock Grid.Row="5" Text="Heavy armor usage ratio (0–1)" Style="{StaticResource HelpLabel}"
                                                   ToolTip="Share of analyzed raids in which you wore armor at or above the configured heavy armor class." />
                                        <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding HeavyArmorUsageThreshold, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"
                                                 ToolTip="0.6 = heavy armor was used in 60 percent of analyzed raids." />
                                        <TextBlock Grid.Row="6" Text="Survival ratio (0–1)" Style="{StaticResource HelpLabel}"
                                                   ToolTip="Minimum recent survival rate used as an additional sign that the player is performing consistently well." />
                                        <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding SurvivalRateThreshold, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"
                                                 ToolTip="0.5 = you survived at least half of the analyzed raids." />
                                    </Grid>
                                </GroupBox>

                                <GroupBox Header="Equipment safety limits">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="105" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="Attachment depth (1–4)" Style="{StaticResource HelpLabel}"
                                                   ToolTip="Technical safety limit for how deeply CP searches nested weapon attachments. Recommended: 3. Increase only if a compatible optic is not found." />
                                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding MaximumAttachmentDepth, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"
                                                 ToolTip="Recommended value: 3. This is an advanced compatibility setting." />
                                        <TextBlock Grid.Row="1" Text="Penetration increase (0–30)" Style="{StaticResource HelpLabel}"
                                                   ToolTip="Maximum penetration points CP may add when selecting stronger ammunition as a response to heavy armor." />
                                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding AmmoPenetrationIncrease, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"
                                                 ToolTip="Higher values allow a stronger ammunition upgrade. Keep this moderate for balance." />
                                        <TextBlock Grid.Row="2" Text="Penetration cap (0–100)" Style="{StaticResource HelpLabel}"
                                                   ToolTip="Hard ceiling for ammunition penetration selected by CP. The final ammunition will never exceed this value." />
                                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding AmmoPenetrationCap, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"
                                                 ToolTip="Maximum allowed penetration after CP chooses an ammunition countermeasure." />
                                    </Grid>
                                </GroupBox>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Wayland">
                    <Grid Margin="12" DataContext="{Binding Wayland}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="1.35*" />
                        </Grid.RowDefinitions>

                        <GroupBox Grid.Row="0" Header="Trader behaviour">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="115" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="115" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="115" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" Content="Show offers on flea" IsChecked="{Binding ShowOffersOnFlea}" Margin="4,7,18,7"
                                          ToolTip="Makes Wayland's offers visible when browsing the flea market. This does not give other traders his stock." />
                                <ComboBox Grid.Column="1" SelectedValue="{Binding PriceSource}" SelectedValuePath="Tag"
                                          ToolTip="Selects the base price used before the multiplier is applied. Flea uses the current flea price when available; Handbook uses the game's fixed handbook value.">
                                    <ComboBoxItem Content="Flea price" Tag="flea" />
                                    <ComboBoxItem Content="Handbook price" Tag="handbook" />
                                </ComboBox>
                                <TextBlock Grid.Column="2" Text="Multiplier" Style="{StaticResource HelpLabel}" Margin="12,0,2,0"
                                           ToolTip="Multiplies the selected base price. Example: 1.20 makes items 20 percent more expensive; 0.80 makes them 20 percent cheaper." />
                                <TextBox Grid.Column="3" Text="{Binding PriceMultiplier, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"
                                         ToolTip="Example: 1.20 = base price plus 20 percent." />
                                <TextBlock Grid.Column="4" Text="Minimum ₽" Style="{StaticResource HelpLabel}" Margin="12,0,2,0"
                                           ToolTip="Lowest automatic price Wayland may use, even when the calculated price would be cheaper." />
                                <TextBox Grid.Column="5" Text="{Binding MinimumPrice, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"
                                         ToolTip="Minimum automatic selling price in roubles." />
                                <TextBlock Grid.Column="6" Text="Refresh min/max" Style="{StaticResource HelpLabel}" Margin="12,0,2,0"
                                           ToolTip="Minimum and maximum number of minutes between Wayland stock refreshes. The game chooses a time within this range." />
                                <StackPanel Grid.Column="7" Orientation="Horizontal">
                                    <TextBox Width="52" Text="{Binding RefreshTimeMinMinutes, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"
                                             ToolTip="Shortest possible refresh time, in minutes." />
                                    <TextBox Width="52" Text="{Binding RefreshTimeMaxMinutes, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"
                                             ToolTip="Longest possible refresh time, in minutes." />
                                </StackPanel>
                            </Grid>
                        </GroupBox>

                        <GroupBox Grid.Row="1" Header="Category defaults">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Margin="8" VerticalAlignment="Top">
                                    <Button Content="Add" Click="AddWaylandCategory_Click" ToolTip="Add settings for another SALCO's ARMORY content folder." />
                                    <Button Content="Remove" Click="RemoveWaylandCategory_Click" ToolTip="Remove the selected category setting." />
                                </StackPanel>
                                <DataGrid x:Name="WaylandCategoryGrid" ItemsSource="{Binding Categories}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Width="*" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}">
                                            <DataGridTextColumn.Header><TextBlock Text="Content folder" ToolTip="Folder/category whose items receive these default Wayland values. Do not rename existing entries unless the content folder was renamed." Cursor="Help" /></DataGridTextColumn.Header>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Width="150" Binding="{Binding LoyaltyLevel, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}">
                                            <DataGridTextColumn.Header><TextBlock Text="Loyalty level" ToolTip="Wayland level required to buy items from this category. Valid levels are 1 to 4." Cursor="Help" /></DataGridTextColumn.Header>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Width="130" Binding="{Binding Stock, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}">
                                            <DataGridTextColumn.Header><TextBlock Text="Stock" ToolTip="How many units of each category item Wayland receives per stock refresh." Cursor="Help" /></DataGridTextColumn.Header>
                                        </DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </GroupBox>

                        <GroupBox Grid.Row="2" Header="Item-specific overrides">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Margin="8" VerticalAlignment="Top">
                                    <Button Content="Add" Click="AddWaylandItem_Click" ToolTip="Add a special rule for one item. You will need that item's template ID." />
                                    <Button Content="Remove" Click="RemoveWaylandItem_Click" ToolTip="Remove the selected item-specific rule. The category default will then apply again." />
                                </StackPanel>
                                <DataGrid x:Name="WaylandItemGrid" ItemsSource="{Binding ItemOverrides}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Width="*" Binding="{Binding TemplateId, UpdateSourceTrigger=PropertyChanged}">
                                            <DataGridTextColumn.Header><TextBlock Text="Template ID" ToolTip="Unique technical ID of the item. Do not change an existing ID unless you know the replacement item ID." Cursor="Help" /></DataGridTextColumn.Header>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Width="1.25*" Binding="{Binding DisplayName}" IsReadOnly="True">
                                            <DataGridTextColumn.Header><TextBlock Text="Item" ToolTip="Readable item name detected from SALCO's ARMORY content. This field cannot be edited." Cursor="Help" /></DataGridTextColumn.Header>
                                        </DataGridTextColumn>
                                        <DataGridCheckBoxColumn Width="90" Binding="{Binding Enabled}">
                                            <DataGridCheckBoxColumn.Header><TextBlock Text="Enabled" ToolTip="Checked: Wayland sells this item. Unchecked: this item is removed from his offers." Cursor="Help" /></DataGridCheckBoxColumn.Header>
                                        </DataGridCheckBoxColumn>
                                        <DataGridTextColumn Width="70" Binding="{Binding LoyaltyLevel, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}">
                                            <DataGridTextColumn.Header><TextBlock Text="LL" ToolTip="Wayland loyalty level required for this specific item. Valid levels are 1 to 4." Cursor="Help" /></DataGridTextColumn.Header>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Width="90" Binding="{Binding Stock, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}">
                                            <DataGridTextColumn.Header><TextBlock Text="Stock" ToolTip="Number of this item Wayland receives per refresh." Cursor="Help" /></DataGridTextColumn.Header>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Width="130" Binding="{Binding Price, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}">
                                            <DataGridTextColumn.Header><TextBlock Text="Fixed price ₽" ToolTip="Optional fixed price in roubles. Leave empty to use the automatic base price, multiplier and minimum price." Cursor="Help" /></DataGridTextColumn.Header>
                                        </DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </GroupBox>
                    </Grid>
                </TabItem>

                <TabItem Header="Soft Armor">
                    <Grid Margin="12" DataContext="{Binding SoftArmor}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="1.45*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="{StaticResource PanelBackground}" Padding="12" Margin="8">
                            <StackPanel>
                                <CheckBox Content="Enable role-based Soft Armor Insert rebalance" IsChecked="{Binding Enabled}"
                                          ToolTip="Applies SALCO's ARMORY balance differences to soft armor classes and insert positions. Disable this to keep their original values." />
                                <TextBlock Style="{StaticResource HintText}"
                                           Text="Smaller inserts inherit weight, penalties and prices from their armor class through the position multipliers below. Hover over a column name for a plain-language explanation." />
                            </StackPanel>
                        </Border>

                        <GroupBox Grid.Row="1" Header="Armor classes">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Margin="8" VerticalAlignment="Top">
                                    <Button Content="Add" Click="AddArmorClass_Click" ToolTip="Add balance values for another armor class." />
                                    <Button Content="Remove" Click="RemoveArmorClass_Click" ToolTip="Remove the selected armor class entry." />
                                </StackPanel>
                                <DataGrid x:Name="ArmorClassGrid" ItemsSource="{Binding Classes}" HorizontalScrollBarVisibility="Auto">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Width="65" Binding="{Binding ArmorClass, UpdateSourceTrigger=PropertyChanged}">
                                            <DataGridTextColumn.Header><TextBlock Text="Class" ToolTip="Armor protection class this row configures, from 1 to 6." Cursor="Help" /></DataGridTextColumn.Header>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Width="90" Binding="{Binding BaseDurability, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}">
                                            <DataGridTextColumn.Header><TextBlock Text="Durability" ToolTip="Base durability of a full front/back insert at this class. Higher values absorb more damage before breaking." Cursor="Help" /></DataGridTextColumn.Header>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Width="75" Binding="{Binding BluntThroughput, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}">
                                            <DataGridTextColumn.Header><TextBlock Text="Blunt" ToolTip="Blunt damage passed through when a hit is stopped. Lower values protect the wearer better." Cursor="Help" /></DataGridTextColumn.Header>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Width="75" Binding="{Binding FullSetWeightKg, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}">
                                            <DataGridTextColumn.Header><TextBlock Text="Set kg" ToolTip="Total target weight in kilograms for a complete set of inserts at this class." Cursor="Help" /></DataGridTextColumn.Header>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Width="80" Binding="{Binding FullSetSpeedPenaltyPercent, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}">
                                            <DataGridTextColumn.Header><TextBlock Text="Speed %" ToolTip="Movement-speed penalty for a complete insert set. Larger penalties slow the player more." Cursor="Help" /></DataGridTextColumn.Header>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Width="75" Binding="{Binding FullSetMousePenalty, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}">
                                            <DataGridTextColumn.Header><TextBlock Text="Mouse" ToolTip="Turning or mouse-movement penalty for a complete insert set. Larger values feel more restrictive." Cursor="Help" /></DataGridTextColumn.Header>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Width="75" Binding="{Binding FullSetErgonomicPenalty, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}">
                                            <DataGridTextColumn.Header><TextBlock Text="Ergo" ToolTip="Ergonomics penalty for a complete insert set. Larger values reduce weapon handling more." Cursor="Help" /></DataGridTextColumn.Header>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Width="80" Binding="{Binding RepairCost, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}">
                                            <DataGridTextColumn.Header><TextBlock Text="Repair" ToolTip="Repair-cost factor used for inserts in this armor class. Higher values make repairs more expensive." Cursor="Help" /></DataGridTextColumn.Header>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Width="105" Binding="{Binding FrontBackFleaPrice, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}">
                                            <DataGridTextColumn.Header><TextBlock Text="Flea ₽" ToolTip="Base flea-market price in roubles for a full-size front or back insert." Cursor="Help" /></DataGridTextColumn.Header>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Width="115" Binding="{Binding FrontBackHandbookPrice, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}">
                                            <DataGridTextColumn.Header><TextBlock Text="Handbook ₽" ToolTip="Base handbook value in roubles for a full-size front or back insert." Cursor="Help" /></DataGridTextColumn.Header>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Width="95" Binding="{Binding StaticLootWeight, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}">
                                            <DataGridTextColumn.Header><TextBlock Text="Loot weight" ToolTip="Relative chance used when inserting this armor class into static loot. Higher values make it more common." Cursor="Help" /></DataGridTextColumn.Header>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Width="85" Binding="{Binding WaylandStock, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}">
                                            <DataGridTextColumn.Header><TextBlock Text="Wayland" ToolTip="Number of inserts from this armor class Wayland receives per stock refresh." Cursor="Help" /></DataGridTextColumn.Header>
                                        </DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </GroupBox>

                        <GroupBox Grid.Row="2" Header="Insert positions">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Margin="8" VerticalAlignment="Top">
                                    <Button Content="Add" Click="AddArmorPosition_Click" ToolTip="Add balance multipliers for another insert position." />
                                    <Button Content="Remove" Click="RemoveArmorPosition_Click" ToolTip="Remove the selected insert-position entry." />
                                </StackPanel>
                                <DataGrid x:Name="ArmorPositionGrid" ItemsSource="{Binding Positions}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Width="*" Binding="{Binding Position, UpdateSourceTrigger=PropertyChanged}">
                                            <DataGridTextColumn.Header><TextBlock Text="Position" ToolTip="Insert location, such as front, back or side. Existing technical names should normally not be changed." Cursor="Help" /></DataGridTextColumn.Header>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Width="190" Binding="{Binding DurabilityMultiplier, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}">
                                            <DataGridTextColumn.Header><TextBlock Text="Durability multiplier" ToolTip="Multiplies class durability for this position. Example: 0.5 gives the insert half of the class base durability." Cursor="Help" /></DataGridTextColumn.Header>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Width="160" Binding="{Binding SetShare, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}">
                                            <DataGridTextColumn.Header><TextBlock Text="Full-set share" ToolTip="Share of the full set's total weight and penalties assigned to this insert position. The shares of a complete set should add up to 1.0." Cursor="Help" /></DataGridTextColumn.Header>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Width="170" Binding="{Binding PriceMultiplier, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}">
                                            <DataGridTextColumn.Header><TextBlock Text="Price multiplier" ToolTip="Multiplies the class price for this position. Example: 0.35 gives it 35 percent of the full-size front/back price." Cursor="Help" /></DataGridTextColumn.Header>
                                        </DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </GroupBox>
                    </Grid>
                </TabItem>

                <TabItem Header="Runtime Injection">
                    <Grid Margin="12" DataContext="{Binding RuntimeInjection}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="{StaticResource PanelBackground}" Padding="12" Margin="8">
                            <StackPanel>
                                <TextBlock Foreground="{StaticResource DangerBrush}"
                                           FontWeight="SemiBold"
                                           Margin="4,0,4,6"
                                           Text="Advanced settings: incorrect template IDs or slot names can prevent affected items from loading." />
                                <CheckBox Content="Apply runtime injection to the player Scav" IsChecked="{Binding ApplyToPlayerScav}"
                                          ToolTip="Checked: runtime item injection also modifies the equipment used by your player Scav. Unchecked: it applies only to your PMC profile." />
                                <TextBlock Style="{StaticResource HintText}"
                                           Text="Each target is an existing item. Its configured slots receive the listed items while the server loads. Normal users should keep the supplied values unchanged." />
                            </StackPanel>
                        </Border>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0.9*" />
                                <ColumnDefinition Width="1.4*" />
                            </Grid.ColumnDefinitions>

                            <GroupBox Grid.Column="0" Header="Target items">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="Add target" Click="AddRuntimeTarget_Click" ToolTip="Advanced: add an existing item that should receive runtime slot changes." />
                                        <Button Content="Remove target" Click="RemoveRuntimeTarget_Click" ToolTip="Remove runtime injection from the selected target item." />
                                    </StackPanel>
                                    <DataGrid x:Name="RuntimeTargetsGrid"
                                              ItemsSource="{Binding Targets}"
                                              SelectionChanged="RuntimeTargetsGrid_SelectionChanged">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Width="*" Binding="{Binding ItemTpl, UpdateSourceTrigger=PropertyChanged}">
                                                <DataGridTextColumn.Header><TextBlock Text="Target template ID" ToolTip="Unique technical ID of the existing item being modified. An invalid ID means the target cannot be found." Cursor="Help" /></DataGridTextColumn.Header>
                                            </DataGridTextColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </GroupBox>

                            <GroupBox Grid.Column="1" Header="Slots for selected target">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="Add slot" Click="AddRuntimeSlot_Click" ToolTip="Advanced: add another slot and inserted item to the selected target." />
                                        <Button Content="Remove slot" Click="RemoveRuntimeSlot_Click" ToolTip="Remove the selected runtime-injected slot entry." />
                                    </StackPanel>
                                    <DataGrid x:Name="RuntimeSlotsGrid"
                                              ItemsSource="{Binding SelectedItem.Slots, ElementName=RuntimeTargetsGrid}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Width="0.8*" Binding="{Binding SlotName, UpdateSourceTrigger=PropertyChanged}">
                                                <DataGridTextColumn.Header><TextBlock Text="Slot name" ToolTip="Exact technical name of a slot on the target item. Spelling and capitalization must match the game data." Cursor="Help" /></DataGridTextColumn.Header>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Width="*" Binding="{Binding ItemTpl, UpdateSourceTrigger=PropertyChanged}">
                                                <DataGridTextColumn.Header><TextBlock Text="Inserted item template ID" ToolTip="Unique technical ID of the item that should be inserted into the named slot." Cursor="Help" /></DataGridTextColumn.Header>
                                            </DataGridTextColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </GroupBox>
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem Header="Advanced JSONC">
                    <Grid Margin="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <GroupBox Grid.Column="0" Header="Additional config files">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Bottom"
                                           Style="{StaticResource HintText}"
                                           Text="Expert mode. This list includes compatibility rules and future JSON/JSONC files that do not yet have a dedicated tab. Prefer the normal tabs whenever possible." />
                                <ListBox x:Name="AdvancedFilesList"
                                         ItemsSource="{Binding AdvancedFiles}"
                                         DisplayMemberPath="RelativePath"
                                         Background="{StaticResource PanelBackground}"
                                         Foreground="{StaticResource TextBrush}"
                                         BorderBrush="{StaticResource BorderBrush}"
                                         Padding="4" />
                            </DockPanel>
                        </GroupBox>

                        <GroupBox Grid.Column="1" Header="Raw JSONC editor">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0"
                                           Style="{StaticResource HintText}"
                                           Text="Expert mode: edit raw JSONC only when you understand the file structure. A missing comma, quote or bracket makes the file invalid. SAC checks the syntax before saving and includes these files in backups, imports and exports." />
                                <TextBox Grid.Row="1"
                                         Text="{Binding SelectedItem.Text, ElementName=AdvancedFilesList, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True"
                                         AcceptsTab="True"
                                         FontFamily="Cascadia Mono, Consolas"
                                         FontSize="13"
                                         HorizontalScrollBarVisibility="Auto"
                                         VerticalScrollBarVisibility="Auto"
                                         TextWrapping="NoWrap" />
                            </Grid>
                        </GroupBox>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>
